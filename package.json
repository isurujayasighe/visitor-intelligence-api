{
  "name": "visitor-intelligence-fastify",
  "version": "1.0.0",
  "private": true,
  "description": "Fastify endpoint for Server GTM visitor IP intelligence and marketing dashboard APIs",
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "backfill:visit-sessions": "tsx src/scripts/backfill-visit-sessions.ts",
    "seed:company-intelligence": "tsx src/scripts/seed-company-intelligence.ts",
    "lint": "eslint \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/helmet": "^12.0.1",
    "@fastify/rate-limit": "^10.2.2",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^5.2.6",
    "@fastify/type-provider-typebox": "^5.1.0",
    "@maxmind/geoip2-node": "^6.1.0",
    "@prisma/client": "^6.8.2",
    "@sinclair/typebox": "^0.34.33",
    "fastify": "^5.3.3",
    "fastify-plugin": "^5.0.1",
    "nanoid": "^5.1.5"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "eslint": "^9.27.0",
    "pino-pretty": "^13.0.0",
    "prisma": "^6.8.2",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
