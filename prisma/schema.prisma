generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CompanyConfidence {
  low
  medium
  high
}

model IpIntelligence {
  id                String            @id @default(cuid())
  ipHash            String            @unique
  ipAddress         String?
  country           String?
  countryCode       String?
  region            String?
  regionCode        String?
  city              String?
  postalCode        String?
  latitude          Float?
  longitude         Float?
  accuracyRadius    Int?
  timezone          String?

  asn               String?
  asName            String?
  asDomain          String?
  asnNetwork        String?
  reverseDns        String?
  rdapName          String?
  rdapEntity        String?

  networkName       String?
  companyGuess      String?
  companyDomain     String?
  companyConfidence CompanyConfidence @default(low)
  companyReason     String?

  geoSource         String?
  asnSource         String?
  lookupSource      String?

  lastLookupAt      DateTime
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  events            VisitorEvent[]

  @@index([countryCode])
  @@index([asn])
  @@index([companyGuess])
  @@index([companyConfidence])
}

model VisitorEvent {
  id                String            @id @default(cuid())
  occurredAt        DateTime          @default(now())

  eventName         String
  clientId          String?
  pageUrl           String?
  pageHostname      String?
  pagePath          String?
  pageTitle         String?
  normalizedPageUrl String?
  normalizedPageHostname String?
  normalizedPagePath String?
  pageGroup         String?
  pageGroupSource   String?
  pageSlug          String?
  userAgent         String?
  referrer          String?

  utmSource         String?
  utmMedium         String?
  utmCampaign       String?

  ipHash            String
  ipAddress         String?

  country           String?
  countryCode       String?
  region            String?
  city              String?
  asn               String?
  networkName       String?
  companyGuess      String?
  companyConfidence CompanyConfidence @default(low)

  ipIntelligenceId  String?
  ipIntelligence    IpIntelligence?   @relation(fields: [ipIntelligenceId], references: [id], onDelete: SetNull)
  visitSessionId    String?
  visitSession      VisitSession?     @relation(fields: [visitSessionId], references: [id], onDelete: SetNull)

  rawPayload         Json?

  createdAt         DateTime          @default(now())

  @@index([occurredAt])
  @@index([eventName])
  @@index([countryCode])
  @@index([companyGuess])
  @@index([companyConfidence])
  @@index([pageHostname])
  @@index([pagePath])
  @@index([pageGroup])
  @@index([normalizedPagePath])
  @@index([normalizedPageHostname])
  @@index([occurredAt, pageGroup])
  @@index([visitSessionId])
  @@index([utmSource])
}

model VisitSession {
  id                         String         @id @default(cuid())

  sessionKey                 String         @unique
  clientId                   String?
  ipHash                     String
  ipAddress                  String?

  country                    String?
  countryCode                String?

  startedAt                  DateTime
  endedAt                    DateTime?
  sessionDurationSeconds     Int?

  landedUrl                  String?
  landedUrlHostname          String?
  landedUrlPath              String?
  landedUrlGroup             String?
  landedUrlGroupRuleId       String?

  exitUrl                    String?
  exitUrlHostname            String?
  exitUrlPath                String?
  exitUrlGroup               String?
  exitUrlGroupRuleId         String?

  userAgent                  String?

  createdAt                  DateTime       @default(now())
  updatedAt                  DateTime       @updatedAt

  events                     VisitorEvent[]

  @@index([startedAt])
  @@index([countryCode])
  @@index([landedUrlGroup])
  @@index([exitUrlGroup])
  @@index([ipHash])
  @@index([sessionDurationSeconds])
}

model PageGroupRule {
  id          String   @id @default(cuid())
  name        String
  matchType   String
  pattern     String
  groupName   String
  priority    Int      @default(100)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive, priority])
  @@index([groupName])
}

model UrlGroupRule {
  id          String   @id @default(cuid())
  name        String
  description String?
  pattern     String
  groupName   String
  priority    Int      @default(100)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive, priority])
  @@index([groupName])
}
