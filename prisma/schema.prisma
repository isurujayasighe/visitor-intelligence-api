generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CompanyConfidence {
  low
  medium
  high
}

model IpIntelligence {
  id                String            @id @default(cuid())
  ipHash            String            @unique
  ipAddress         String?
  country           String?
  countryCode       String?
  region            String?
  regionCode        String?
  city              String?
  postalCode        String?
  latitude          Float?
  longitude         Float?
  accuracyRadius    Int?
  timezone          String?

  asn               String?
  asName            String?
  asDomain          String?
  asnNetwork        String?
  reverseDns        String?
  rdapName          String?
  rdapEntity        String?

  networkName       String?
  companyGuess      String?
  companyDomain     String?
  companyConfidence CompanyConfidence @default(low)
  companyReason     String?
  networkType       String?
  isLeadNetwork     Boolean           @default(false)
  companySource     String?
  companyEvidence   Json?
  matchedCompanyMappingId String?
  matchedNetworkRuleId String?

  geoSource         String?
  asnSource         String?
  lookupSource      String?

  lastLookupAt      DateTime
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  events            VisitorEvent[]

  @@index([countryCode])
  @@index([asn])
  @@index([companyGuess])
  @@index([companyConfidence])
  @@index([networkType])
  @@index([isLeadNetwork])
}

model VisitorEvent {
  id                String            @id @default(cuid())
  occurredAt        DateTime          @default(now())

  eventName         String
  clientId          String?
  pageUrl           String?
  pageHostname      String?
  pagePath          String?
  pageTitle         String?
  normalizedPageUrl String?
  normalizedPageHostname String?
  normalizedPagePath String?
  pageGroup         String?
  pageGroupSource   String?
  pageSlug          String?
  userAgent         String?
  referrer          String?

  utmSource         String?
  utmMedium         String?
  utmCampaign       String?

  ipHash            String
  ipAddress         String?

  country           String?
  countryCode       String?
  region            String?
  city              String?
  asn               String?
  networkName       String?
  companyGuess      String?
  companyConfidence CompanyConfidence @default(low)

  ipIntelligenceId  String?
  ipIntelligence    IpIntelligence?   @relation(fields: [ipIntelligenceId], references: [id], onDelete: SetNull)
  visitSessionId    String?
  visitSession      VisitSession?     @relation(fields: [visitSessionId], references: [id], onDelete: SetNull)
  visitorId          String?
  visitor            AnonymousVisitor? @relation(fields: [visitorId], references: [id], onDelete: SetNull)

  rawPayload         Json?

  createdAt         DateTime          @default(now())

  @@index([occurredAt])
  @@index([eventName])
  @@index([countryCode])
  @@index([companyGuess])
  @@index([companyConfidence])
  @@index([pageHostname])
  @@index([pagePath])
  @@index([pageGroup])
  @@index([normalizedPagePath])
  @@index([normalizedPageHostname])
  @@index([occurredAt, pageGroup])
  @@index([visitSessionId])
  @@index([visitorId])
  @@index([utmSource])
}

model AnonymousVisitor {
  id                 String         @id @default(cuid())

  visitorKey         String         @unique
  clientId           String?
  ipHash             String?
  userAgentHash      String?

  firstSeenAt        DateTime
  lastSeenAt         DateTime

  firstCountry       String?
  firstCountryCode   String?
  lastCountry        String?
  lastCountryCode    String?

  firstPageUrl       String?
  lastPageUrl        String?

  firstUtmSource     String?
  firstUtmMedium     String?
  firstUtmCampaign   String?

  eventCount         Int            @default(0)
  sessionCount       Int            @default(0)

  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  events             VisitorEvent[]

  @@index([firstSeenAt])
  @@index([lastSeenAt])
  @@index([clientId])
  @@index([firstCountryCode])
  @@index([lastCountryCode])
}

model VisitSession {
  id                         String         @id @default(cuid())

  sessionKey                 String         @unique
  clientId                   String?
  ipHash                     String
  ipAddress                  String?

  country                    String?
  countryCode                String?

  startedAt                  DateTime
  endedAt                    DateTime?
  sessionDurationSeconds     Int?

  landedUrl                  String?
  landedUrlHostname          String?
  landedUrlPath              String?
  landedUrlGroup             String?
  landedUrlGroupRuleId       String?

  exitUrl                    String?
  exitUrlHostname            String?
  exitUrlPath                String?
  exitUrlGroup               String?
  exitUrlGroupRuleId         String?

  userAgent                  String?

  createdAt                  DateTime       @default(now())
  updatedAt                  DateTime       @updatedAt

  events                     VisitorEvent[]

  @@index([startedAt])
  @@index([countryCode])
  @@index([landedUrlGroup])
  @@index([exitUrlGroup])
  @@index([ipHash])
  @@index([sessionDurationSeconds])
}

model PageGroupRule {
  id          String   @id @default(cuid())
  name        String
  matchType   String
  pattern     String
  groupName   String
  priority    Int      @default(100)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive, priority])
  @@index([groupName])
}

model UrlGroupRule {
  id          String   @id @default(cuid())
  name        String
  description String?
  pattern     String
  groupName   String
  priority    Int      @default(100)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive, priority])
  @@index([groupName])
}

model CompanyIpMapping {
  id              String   @id @default(cuid())

  companyName     String
  companyDomain   String?
  ipRange         String
  source          String
  confidence      String
  notes           String?

  isActive        Boolean  @default(true)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([companyName])
  @@index([companyDomain])
  @@index([isActive])
}

model NetworkClassifierRule {
  id            String   @id @default(cuid())

  name          String
  pattern       String
  matchType     String
  networkType   String
  isLeadNetwork Boolean  @default(false)
  priority      Int      @default(100)
  isActive      Boolean  @default(true)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([isActive, priority])
  @@index([networkType])
}
